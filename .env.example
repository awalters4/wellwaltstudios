# /api/intake serverless function — env vars (set in Vercel → Project → Settings
# → Environment Variables, for Production). Do not commit real values.

# Base URL of the ops app that receives leads. The function POSTs to
# ${OPS_INGEST_URL}/api/ingest/lead  (must be a live, reachable URL)
OPS_INGEST_URL=

# Bearer token the ops app expects (sent as Authorization: Bearer <secret>)
OPS_INGEST_SECRET=

# Email notification uses the project's existing SMTP setup (the same vars the
# booking/spring functions already use). These are likely already set:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Optional: where lead notifications are sent (defaults to ariel@wellwaltstudios.com)
LEAD_EMAIL=

# NOTE: Web3Forms is no longer used — its free plan blocks server-side
# submissions. The old WEB3FORMS_KEY can be removed from Vercel, and since it was
# exposed in git history it should be rotated/deleted at web3forms.com anyway.
