# /api/intake serverless function — set these in Vercel project settings
# (Project → Settings → Environment Variables). Do not commit real values.

# Base URL of the ops app that receives leads. The function POSTs to
# ${OPS_INGEST_URL}/api/ingest/lead
OPS_INGEST_URL=

# Bearer token the ops app expects (sent as Authorization: Bearer <secret>)
OPS_INGEST_SECRET=

# Web3Forms access key — server-side only now (was previously public in constants.js).
# Rotate the old key, since it was exposed in the repo history.
WEB3FORMS_KEY=
