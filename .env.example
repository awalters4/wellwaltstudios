# /api/intake serverless function — env vars (set in Vercel → Project → Settings
# → Environment Variables, for Production). Do not commit real values.
#
# /api/intake only saves the lead to the ops app. The email notification is sent
# client-side via Web3Forms (its free plan is browser-only), so no email or
# Web3Forms vars are needed here.

# Base URL of the ops app that receives leads. Must be LIVE and reachable.
# The function POSTs to  ${OPS_INGEST_URL}/api/ingest/lead
OPS_INGEST_URL=

# Bearer token the ops app expects (sent as Authorization: Bearer <secret>)
OPS_INGEST_SECRET=
